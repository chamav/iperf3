<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include essential user data -->
        <include domain="database" path="iperf_database"/>
        <include domain="sharedpref" path="user_preferences"/>
        
        <!-- Exclude logs and temporary data -->
        <exclude domain="file" path="logs/"/>
        <exclude domain="file" path="temp/"/>
        <exclude domain="cache"/>
    </cloud-backup>
    
    <device-transfer>
        <!-- Include all user data for device transfer -->
        <include domain="database"/>
        <include domain="sharedpref"/>
        
        <!-- Exclude only truly temporary data -->
        <exclude domain="cache"/>
    </device-transfer>
</data-extraction-rules>